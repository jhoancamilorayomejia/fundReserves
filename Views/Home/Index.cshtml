@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - FoundReserves</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body>

    <div class="login-card">

        <h2>FoundReserves</h2>

        <p class="subtitle">
            Inicia sesión en tu cuenta
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                @ViewBag.Error
            </div>
        }

        <form method="post"
              asp-controller="Home"
              asp-action="Login">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">
                    Número de cédula
                </label>

                <input type="text"
                    name="Cedula"
                    class="form-control"
                    placeholder="Ingresa tu número de cédula"
                    required />
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Contraseña
                </label>

                <input type="password"
                    name="Password"
                    class="form-control"
                    placeholder="••••••••"
                    required />
            </div>

            <button type="submit" class="btn-login">
                Iniciar sesión
            </button>

        </form>

        <!-- BOTÓN REGISTRO -->

        <button class="btn-register"
                data-bs-toggle="modal"
                data-bs-target="#registerModal">

            ¿Desea realizar el registro de Usuario?

        </button>

    </div>

    <!-- MODAL REGISTRO -->

    <div class="modal fade"
        id="registerModal"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Registro de Usuario
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <form id="registerForm">

                        <div class="mb-3">
                            <label>Cédula</label>

                            <input type="text"
                                id="cedula"
                                class="form-control"
                                required />
                        </div>

                        <div class="mb-3">
                            <label>Nombre</label>

                            <input type="text"
                                id="name"
                                class="form-control"
                                required />
                        </div>

                        <div class="mb-3">
                            <label>Apellidos</label>

                            <input type="text"
                                id="lastname"
                                class="form-control"
                                required />
                        </div>

                        <div class="mb-3">
                            <label>Número de celular</label>

                            <input type="text"
                                id="phone"
                                class="form-control"
                                placeholder="Ingresa tu número"
                                required />
                        </div>

                        <div class="mb-3">
                            <label>Correo</label>

                            <input type="email"
                                id="email"
                                class="form-control"
                                required />
                        </div>

                        <input type="password"
                            id="password"
                            class="form-control"
                            minlength="6"
                            pattern="^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]+$"
                            title="La contraseña debe tener mínimo 6 caracteres, letras y números"
                            required />

                        <input type="password"
                        id="confirmPassword"
                        class="form-control"
                        minlength="6"
                        pattern="^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d]+$"
                        title="La contraseña debe tener mínimo 6 caracteres, letras y números"
                        required />

                        <button type="submit"
                                class="btn btn-success w-100">

                            Registrarse

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.getElementById("registerForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const password =
                    document.getElementById("password").value;

                const confirmPassword =
                    document.getElementById("confirmPassword").value;

                if (password !== confirmPassword) {

                    alert("Las contraseñas no coinciden");

                    return;
                }

                const data = {
    cedula: document.getElementById("cedula").value,
    name: document.getElementById("name").value,
    lastname: document.getElementById("lastname").value,
    email: document.getElementById("email").value,
    phone: document.getElementById("phone").value,
    password: password
    // ✅ rol eliminado, el servidor lo asigna automáticamente
};

                try {

    const response =
        await fetch("/api/auth/register", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify(data)
        });

    const result = await response.json();

    console.log("RESPUESTA BACKEND:");
    console.log(result);

    if (response.ok) {

        alert("Usuario registrado correctamente");

        location.reload();

    } else {

        alert(JSON.stringify(result, null, 2));
    }

} catch (error) {

    console.error("ERROR:");
    console.error(error);

    alert(error);
}

            });

    </script>

</body>
</html>