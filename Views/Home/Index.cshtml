@{
    ViewData["Title"] = "Home Page";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - FoundReserves</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/login.css" />
</head>

<body>

    <div class="login-card">

        <h2>FoundReserves</h2>

        <p class="subtitle">
            Inicia sesión en tu cuenta
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                @ViewBag.Error
            </div>
        }

        <form method="post"
              asp-controller="Home"
              asp-action="Login">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">
                    Número de cédula
                </label>

                <input type="text"
                    name="Cedula"
                    class="form-control"
                    placeholder="Ingresa tu número de cédula"
                    required />
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Contraseña
                </label>

                <input type="password"
                    name="Password"
                    class="form-control"
                    placeholder="••••••••"
                    required />
            </div>

            <button type="submit" class="btn-login">
                Iniciar sesión
            </button>

        </form>

        <!-- BOTÓN REGISTRO -->

        <button class="btn-register"
                data-bs-toggle="modal"
                data-bs-target="#registerModal">

            ¿Desea realizar el registro de Usuario?

        </button>

    </div>

    <!-- MODAL REGISTRO -->

    <div class="modal fade"
        id="registerModal"
        tabindex="-1"
        aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        Registro de Usuario
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">
    <form id="registerForm">

        <!-- Fila 1 -->
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Cédula <span class="text-danger">*</span></label>
                <input type="text" id="cedula" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Fecha de nacimiento <span class="text-danger">*</span></label>
                <input type="date" id="fechaNacimiento" class="form-control" required />
            </div>
        </div>

        <!-- Fila 2 -->
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">Nombre(s) <span class="text-danger">*</span></label>
                <input type="text" id="name" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Apellidos <span class="text-danger">*</span></label>
                <input type="text" id="lastname" class="form-control" required />
            </div>
        </div>

        <!-- Fila 3 -->
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">Celular <span class="text-danger">*</span></label>
                <input type="text" id="phone" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Correo electrónico <span class="text-danger">*</span></label>
                <input type="email" id="email" class="form-control" required />
            </div>
        </div>

        <!-- Fila 4 -->
        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <label class="form-label">Departamento <span class="text-danger">*</span></label>
                <select id="departamento" class="form-select" required>
                    <option value="">Seleccione...</option>
                    <option>Antioquia</option>
                    <option>Atlántico</option>
                    <option>Bogotá D.C.</option>
                    <option>Bolívar</option>
                    <option>Boyacá</option>
                    <option>Caldas</option>
                    <option>Cauca</option>
                    <option>Cundinamarca</option>
                    <option>Huila</option>
                    <option>Magdalena</option>
                    <option>Nariño</option>
                    <option>Norte de Santander</option>
                    <option>Quindío</option>
                    <option>Risaralda</option>
                    <option>Santander</option>
                    <option>Tolima</option>
                    <option>Valle del Cauca</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Municipio <span class="text-danger">*</span></label>
                <input type="text" id="municipio" class="form-control" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Barrio <span class="text-danger">*</span></label>
                <input type="text" id="barrio" class="form-control" required />
            </div>
        </div>

        <!-- Dirección -->
        <div class="mt-3">
            <label class="form-label">Dirección de residencia <span class="text-danger">*</span></label>
            <input type="text" id="direccion" class="form-control" required />
        </div>

        <!-- Pregunta secreta -->
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">Pregunta secreta <span class="text-danger">*</span></label>
                <select id="preguntaSecreta" class="form-select" required>
                    <option value="">Seleccione una pregunta...</option>
                    <option>¿Cuál es el nombre de tu primera mascota?</option>
                    <option>¿En qué ciudad naciste?</option>
                    <option>¿Cuál es el apellido de soltera de tu madre?</option>
                    <option>¿Cuál fue el nombre de tu escuela primaria?</option>
                    <option>¿Cuál es tu película favorita?</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Respuesta secreta <span class="text-danger">*</span></label>
                <input type="text" id="respuestaSecreta" class="form-control" required />
            </div>
        </div>

        <!-- Autorizaciones -->
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label d-block">¿Autoriza envío de info al correo?</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="autorizaCorreo" id="correoSi" value="true" checked />
                    <label class="form-check-label" for="correoSi">Sí</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="autorizaCorreo" id="correoNo" value="false" />
                    <label class="form-check-label" for="correoNo">No</label>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label d-block">¿Autoriza envío de info al celular?</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="autorizaCelular" id="celularSi" value="true" checked />
                    <label class="form-check-label" for="celularSi">Sí</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="autorizaCelular" id="celularNo" value="false" />
                    <label class="form-check-label" for="celularNo">No</label>
                </div>
            </div>
        </div>

        <!-- Contraseñas -->
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">Contraseña <span class="text-danger">*</span></label>
                <input type="password" id="password" class="form-control" minlength="6" required />
                <div class="form-text">Mínimo 6 caracteres, letras y números.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">Confirmar contraseña <span class="text-danger">*</span></label>
                <input type="password" id="confirmPassword" class="form-control" minlength="6" required />
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100 mt-4">
            Registrarse
        </button>

    </form>
</div>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        document.getElementById("registerForm")
            .addEventListener("submit", async function (e) {

                e.preventDefault();

                const password =
                    document.getElementById("password").value;

                const confirmPassword =
                    document.getElementById("confirmPassword").value;

                if (password !== confirmPassword) {

                    alert("Las contraseñas no coinciden");

                    return;
                }

                const data = {
    cedula:           document.getElementById("cedula").value,
    name:             document.getElementById("name").value,
    lastname:         document.getElementById("lastname").value,
    phone:            document.getElementById("phone").value,
    email:            document.getElementById("email").value,
    password:         password,
    fechaNacimiento:  document.getElementById("fechaNacimiento").value,
    departamento:     document.getElementById("departamento").value,
    municipio:        document.getElementById("municipio").value,
    barrio:           document.getElementById("barrio").value,
    direccion:        document.getElementById("direccion").value,
    preguntaSecreta:  document.getElementById("preguntaSecreta").value,
    respuestaSecreta: document.getElementById("respuestaSecreta").value,
    autorizaCorreo:   document.querySelector('input[name="autorizaCorreo"]:checked').value === "true",
    autorizaCelular:  document.querySelector('input[name="autorizaCelular"]:checked').value === "true"
};

                try {

    const response =
        await fetch("/api/auth/register", {

            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify(data)
        });

    const result = await response.json();

    console.log("RESPUESTA BACKEND:");
    console.log(result);

    if (response.ok) {

        alert("Usuario registrado correctamente");

        location.reload();

    } else {

        alert(JSON.stringify(result, null, 2));
    }

} catch (error) {

    console.error("ERROR:");
    console.error(error);

    alert(error);
}

            });

    </script>

</body>
</html>