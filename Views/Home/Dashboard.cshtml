        if (!res.ok) { alert(data.message || 'Error al registrar sede'); return; }
        alert('Sede registrada correctamente');
        this.reset();
        cargarSedes();
    } catch (err) {
        console.error('[FR] Error registrar sede:', err);
        alert('Error de conexión');
