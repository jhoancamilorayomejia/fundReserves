/* ══════════════════════════════════════
   ELIMINACIONES (DELETE a la API)
══════════════════════════════════════ */

/* Elimina un usuario por id → DELETE /api/users/:id */
async function eliminarUsuario(id, nombre) {
    if (!confirm(`¿Eliminar al usuario "${nombre}"?\nEsta acción es permanente.`)) return;
    try {
        const res = await fetch(`/api/users/${id}`, { method: 'DELETE' });
        if (!res.ok) { alert((await res.json()).message || res.statusText); return; }
        allUsers = allUsers.filter(u => u.iduser !== id);
        render(allUsers);
        alert(`Usuario "${nombre}" eliminado correctamente`);
    } catch (err) {
        console.error('[FR] Error al eliminar usuario:', err);
        alert('Error de conexión');
    }
}

/* Elimina una temporada por id → DELETE /api/seasons/:id */
async function eliminarTemporada(id, nombre) {
