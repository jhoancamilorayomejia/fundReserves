/* Fila para tabla TARIFAS */
function filaRate(r, i) {
    return `<tr id="fila-rate-${r.idPrice}">
        <td class="fr-mono text-muted">${i + 1}</td>
        <td class="fr-mono text-muted">${r.idPrice || '—'}</td>
        <td>${r.accommodationName || r.idAccommodation}</td>
        <td>${r.seasonType        || r.idSeason}</td>
