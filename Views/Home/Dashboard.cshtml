/* ══════════════════════════════════════
   EDITAR TARIFA
══════════════════════════════════════ */
function abrirEditRate(id, minP, maxP, pN, pA) {
    document.getElementById('edit-rate-id').value        = id;
    document.getElementById('edit-minPerson').value      = minP;
    document.getElementById('edit-maxPerson').value      = maxP;
    document.getElementById('edit-priceNight').value     = pN;
    document.getElementById('edit-priceAdditional').value = pA;
    new bootstrap.Modal(document.getElementById('modal-edit-rate')).show();
}

async function guardarEditRate() {
    const id   = parseInt(document.getElementById('edit-rate-id').value);
    const body = {
        minimumPerson:         parseInt(document.getElementById('edit-minPerson').value),
        maximumPerson:         parseInt(document.getElementById('edit-maxPerson').value),
        priceNight:            parseFloat(document.getElementById('edit-priceNight').value),
        pricePersonAdditional: parseFloat(document.getElementById('edit-priceAdditional').value)
    };

    if (body.minimumPerson > body.maximumPerson) {
        alert('El mínimo no puede ser mayor al máximo.');
        return;
    }

    try {
        const res = await fetch(`/api/rates/update/${id}`, {
            method:  'PUT',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(body)
        });
        const data = await res.json();
        if (!res.ok) { alert(data.message || 'Error al actualizar'); return; }

        bootstrap.Modal.getInstance(
            document.getElementById('modal-edit-rate')
        ).hide();

        alert('Tarifa actualizada correctamente');
        cargarRates();
    } catch (err) {
        console.error('[FR] Error actualizando tarifa:', err);
        alert('Error de conexión');
    }
}


