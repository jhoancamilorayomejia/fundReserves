══════════════════════════════════════ */
let allUsers         = [];
let allSedes         = [];
let allAccommodation = [];
let allSeasons       = [];
let allRates         = [];

/* Títulos y subtítulos por sección */
const SECTIONS = {
    resumen:       { title: 'Resumen',        sub: 'Panel de control general'                },
    admins:        { title: 'Administradores', sub: 'Usuarios con rol Admin'                 },
    customers:     { title: 'Clientes',        sub: 'Usuarios con rol Customer'              },
    sedes:         { title: 'Sedes',           sub: 'Sedes y apartamentos registrados'       },
    accommodation: { title: 'Alojamientos',    sub: 'Habitaciones y apartamentos registrados'},
    seasons:       { title: 'Temporadas',      sub: 'Temporadas altas, bajas y especiales'   },
