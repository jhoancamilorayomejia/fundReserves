    </div>

</div>



    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>

        /* ══════════════════════════════
           ESTADO GLOBAL
        ══════════════════════════════ */
        let allUsers = [];
        

        const SECTIONS = {
            resumen:   { title: 'Resumen',          sub: 'Panel de control general' },
            admins:    { title: 'Administradores',   sub: 'Usuarios con rol Admin' },
            customers: { title: 'Clientes',          sub: 'Usuarios con rol Customer' },
            sedes: { title: 'Sedes', sub: 'Sedes y apartamentos registrados' },
            accommodation: {title: 'Alojamientos',sub: 'Habitaciones y apartamentos registrados'},
            seasons: {title: 'Temporadas',sub: 'Temporadas altas, bajas y especiales'},
            rates: {title: 'Tarifas',sub: 'Tarifas por temporada y alojamiento'}
        };

        /* ══════════════════════════════
           HELPERS
        ══════════════════════════════ */
        function fmtFecha(str) {
            if (!str) return '—';
            try {
                return new Date(str).toLocaleDateString('es-CO', {
                    year: 'numeric', month: 'short', day: '2-digit'
                });
            } catch { return '—'; }
        }

        function rolPill(rol) {
            if (rol === 'Admin')
                return '<span class="fr-pill fr-pill-admin">Admin</span>';
            return '<span class="fr-pill fr-pill-customer">Cliente</span>';
        }

        function iniciales(name, last) {
            return ((name||'').charAt(0) + (last||'').charAt(0)).toUpperCase();
        }

        function avatarHtml(u) {
            const cls = u.rol === 'Admin' ? 'av-admin' : 'av-customer';
            return `<span class="fr-av ${cls}">${iniciales(u.name, u.lastname)}</span>`;
        }

        /* ══════════════════════════════
           CONSTRUCCIÓN DE FILAS
        ══════════════════════════════ */

        // Fila para tabla de resumen (incluye columna Rol)
        function filaResumen(u, i) {
            return `<tr>
                <td class="fr-mono text-muted">${i + 1}</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        ${avatarHtml(u)}
                        <div>
                            <div class="fw-500">${u.name || ''} ${u.lastname || ''}</div>
                            <div class="fr-sub-email">${u.email || ''}</div>
                        </div>
                    </div>
                </td>
                <td class="fr-mono">${u.cedula || '—'}</td>
                <td>${u.phone || '—'}</td>
                <td class="text-muted">${u.email || '—'}</td>
                <td>${rolPill(u.rol)}</td>
                <td class="text-muted fr-mono">${fmtFecha(u.createdAt)}</td>
                <td>
                <button class="btn btn-sm btn-outline-danger"
                onclick="eliminarUsuario(${u.iduser}, '${u.name} ${u.lastname}')">
                Eliminar
