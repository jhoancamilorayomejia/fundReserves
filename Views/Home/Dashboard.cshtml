@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard — FoundReserves</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>

<!-- ════════════════════════════════════════
    SIDEBAR
════════════════════════════════════════ -->
<aside class="fr-sidebar">

    <!-- Marca -->
    <div class="fr-brand">
        <div class="fr-brand-icon">FR</div>
        <span class="fr-brand-name">FoundReserves</span>
    </div>

    <!-- Navegación principal -->
    <nav class="fr-nav">

        <a href="#" class="fr-nav-item active" data-section="resumen">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
            </svg>
            Resumen
        </a>

        <a href="#" class="fr-nav-item" data-section="admins">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="4"/>
                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                <path d="M19 8l1.5 1.5L23 7"/>
            </svg>
            Administradores
            <span class="fr-badge fr-badge-admin" id="cnt-admins">0</span>
        </a>

        <a href="#" class="fr-nav-item" data-section="customers">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Clientes
            <span class="fr-badge fr-badge-customer" id="cnt-customers">0</span>
        </a>

        <a href="#" class="fr-nav-item" data-section="sedes">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            Sedes
            <span class="fr-badge fr-badge-admin" id="cnt-sedes">0</span>
        </a>

        <a href="#" class="fr-nav-item" data-section="accommodation">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="16" rx="2"/>
                <path d="M7 12h10"/>
                <path d="M7 8h4"/>
            </svg>
            Alojamientos
            <span class="fr-badge fr-badge-customer" id="cnt-accommodation">0</span>
        </a>

        <a href="#" class="fr-nav-item" data-section="seasons">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M8 2v4"/>
                <path d="M16 2v4"/>
                <rect width="18" height="18" x="3" y="4" rx="2"/>
                <path d="M3 10h18"/>
            </svg>
            Temporadas
            <span class="fr-badge fr-badge-admin" id="cnt-seasons">0</span>
        </a>

        <a href="#" class="fr-nav-item" data-section="rates">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 1v22"/>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7H14.5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
            Tarifas
            <span class="fr-badge fr-badge-admin" id="cnt-rates">0</span>
        </a>

    </nav>

    <!-- Usuario activo + cerrar sesión -->
    <div class="fr-sidebar-footer">
        <div class="fr-avatar-circle">
            @(ViewBag.Name != null ? ((string)ViewBag.Name).Substring(0,1).ToUpper() : "A")@(ViewBag.Lastname != null ? ((string)ViewBag.Lastname).Substring(0,1).ToUpper() : "")
        </div>
        <div class="fr-user-meta">
            <span class="fr-user-name">@ViewBag.Name @ViewBag.Lastname</span>
            <span class="fr-user-role">Administrador</span>
        </div>
        <form method="post" asp-controller="Home" asp-action="Logout" class="ms-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="fr-btn-logout" title="Cerrar sesión">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </button>
        </form>
    </div>

</aside>


<!-- ════════════════════════════════════════
     CONTENIDO PRINCIPAL
════════════════════════════════════════ -->
<main class="fr-main">

    <!-- Topbar: título dinámico + buscador -->
    <div class="fr-topbar">
        <div>
            <h1 class="fr-page-title" id="page-title">Resumen</h1>
            <p class="fr-page-sub"   id="page-sub">Panel de control general</p>
        </div>
        <div class="fr-search-wrap">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" id="buscador" class="fr-search"
                   placeholder="Buscar por nombre, cédula o correo..." />
        </div>
    </div>

    <!-- Banner de error global -->
    <div id="error-msg" class="alert alert-danger mx-4 mt-3 d-none" role="alert">
        No se pudieron cargar los usuarios. Abre la consola (F12) para más detalles.
    </div>


    <!-- ─────────────────────────────
         SECCIÓN: RESUMEN
    ───────────────────────────── -->
    <div class="fr-section" id="sec-resumen">

        <!-- Tarjetas de estadísticas -->
        <div class="fr-stats-row">
            <div class="fr-stat-card">
                <div class="fr-stat-icon ic-admin">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="8" r="4"/>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                        <path d="M19 8l1.5 1.5L23 7"/>
                    </svg>
                </div>
                <div>
                    <p class="fr-stat-label">Administradores</p>
                    <p class="fr-stat-val" id="s-admins">—</p>
                </div>
            </div>
            <div class="fr-stat-card">
                <div class="fr-stat-icon ic-customer">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <div>
                    <p class="fr-stat-label">Clientes</p>
                    <p class="fr-stat-val" id="s-customers">—</p>
                </div>
            </div>
            <div class="fr-stat-card">
                <div class="fr-stat-icon ic-total">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <div>
                    <p class="fr-stat-label">Total usuarios</p>
                    <p class="fr-stat-val" id="s-total">—</p>
                </div>
            </div>
        </div>

        <!-- Tabla resumen de todos los usuarios -->
        <div class="fr-card">
            <div class="fr-card-head">
                <h2 class="fr-card-title">Todos los usuarios</h2>
                <span class="fr-pill" id="lbl-resumen">cargando...</span>
            </div>
            <div class="table-responsive">
                <table class="table fr-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre completo</th>
                            <th>Cédula</th>
                            <th>Teléfono</th>
                            <th>Correo electrónico</th>
                            <th>Rol</th>
                            <th>Fecha de registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tb-resumen">
                        <tr><td colspan="8" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /sec-resumen -->


    <!-- ─────────────────────────────
         SECCIÓN: ADMINISTRADORES
    ───────────────────────────── -->
    <div class="fr-section d-none" id="sec-admins">
        <div class="fr-card">
            <div class="fr-card-head">
                <h2 class="fr-card-title">Administradores del sistema</h2>
                <span class="fr-pill fr-pill-admin" id="lbl-admins">0 registros</span>
            </div>
            <div class="table-responsive">
                <table class="table fr-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th>Nombre completo</th>
                            <th>Cédula</th>
                            <th>Teléfono</th>
                            <th>Correo electrónico</th>
                            <th>Fecha de registro</th>
                        </tr>
                    </thead>
                    <tbody id="tb-admins">
                        <tr><td colspan="7" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div><!-- /sec-admins -->


    <!-- ─────────────────────────────
         SECCIÓN: CLIENTES
    ───────────────────────────── -->
    <div class="fr-section d-none" id="sec-customers">
        <div class="fr-card">
            <div class="fr-card-head">
                <h2 class="fr-card-title">Clientes registrados</h2>
                <span class="fr-pill fr-pill-customer" id="lbl-customers">0 registros</span>
            </div>
            <!-- Tabla resumida: columnas clave + botón Ver para abrir modal -->
            <div class="table-responsive">
                <table class="table fr-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th>Nombre completo</th>
                            <th>Cédula</th>
                            <th>Teléfono</th>
                            <th>Correo electrónico</th>
                            <th>Municipio</th>
                            <th>Fecha de registro</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tb-customers">
                        <tr><td colspan="9" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div><!-- /sec-customers -->

    <!-- ─────────────────────────────
         MODAL: DETALLE DE CLIENTE
    ───────────────────────────── -->
    <div class="modal fade" id="modal-cliente" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content fr-modal-content">

                <!-- Cabecera del modal -->
                <div class="fr-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fr-modal-avatar" id="modal-avatar">SM</div>
                        <div>
                            <h5 class="fr-modal-title" id="modal-nombre">—</h5>
                            <span class="fr-pill fr-pill-customer" style="font-size:10.5px">Cliente</span>
                        </div>
                    </div>
                    <button type="button" class="fr-modal-close" data-bs-dismiss="modal" aria-label="Cerrar">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>

                <!-- Cuerpo del modal en grupos -->
                <div class="fr-modal-body">

                    <!-- Grupo: Información personal -->
                    <div class="fr-modal-group">
                        <p class="fr-modal-group-label">Información personal</p>
                        <div class="fr-modal-grid">
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">ID</span>
                                <span class="fr-modal-field-val fr-mono" id="md-id">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Cédula</span>
                                <span class="fr-modal-field-val fr-mono" id="md-cedula">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">F. Nacimiento</span>
                                <span class="fr-modal-field-val" id="md-nacimiento">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Teléfono</span>
                                <span class="fr-modal-field-val" id="md-phone">—</span>
                            </div>
                            <div class="fr-modal-field" style="grid-column: span 2">
                                <span class="fr-modal-field-label">Correo electrónico</span>
                                <span class="fr-modal-field-val" id="md-email">—</span>
                            </div>
                        </div>
                    </div>

                    <!-- Grupo: Ubicación -->
                    <div class="fr-modal-group">
                        <p class="fr-modal-group-label">Ubicación</p>
                        <div class="fr-modal-grid">
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Departamento</span>
                                <span class="fr-modal-field-val" id="md-departamento">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Municipio</span>
                                <span class="fr-modal-field-val" id="md-municipio">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Barrio</span>
                                <span class="fr-modal-field-val" id="md-barrio">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Dirección</span>
                                <span class="fr-modal-field-val" id="md-direccion">—</span>
                            </div>
                        </div>
                    </div>

                    <!-- Grupo: Seguridad -->
                    <div class="fr-modal-group">
                        <p class="fr-modal-group-label">Seguridad</p>
                        <div class="fr-modal-grid">
                            <div class="fr-modal-field" style="grid-column: span 2">
                                <span class="fr-modal-field-label">Pregunta secreta</span>
                                <span class="fr-modal-field-val" id="md-pregunta">—</span>
                            </div>
                            <div class="fr-modal-field" style="grid-column: span 2">
                                <span class="fr-modal-field-label">Respuesta secreta</span>
                                <span class="fr-modal-field-val" id="md-respuesta">—</span>
                            </div>
                        </div>
                    </div>

                    <!-- Grupo: Autorizaciones + registro -->
                    <div class="fr-modal-group">
                        <p class="fr-modal-group-label">Autorizaciones y registro</p>
                        <div class="fr-modal-grid">
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Aut. Correo</span>
                                <span class="fr-modal-field-val" id="md-aut-correo">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Aut. Celular</span>
                                <span class="fr-modal-field-val" id="md-aut-celular">—</span>
                            </div>
                            <div class="fr-modal-field">
                                <span class="fr-modal-field-label">Fecha de registro</span>
                                <span class="fr-modal-field-val fr-mono" id="md-registro">—</span>
                            </div>
                        </div>
                    </div>

                </div><!-- /fr-modal-body -->

                <!-- Footer: botón eliminar -->
                <div class="fr-modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-danger" id="modal-btn-eliminar">
                        Eliminar cliente
                    </button>
                    <button type="button" class="btn btn-dark btn-sm" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>

            </div>
        </div>
    </div><!-- /modal-cliente -->


    <!-- ─────────────────────────────
         SECCIÓN: SEDES
    ───────────────────────────── -->
    <div class="fr-section d-none" id="sec-sedes">
        <div class="fr-card">

            <div class="fr-card-head">
                <h2 class="fr-card-title">Sedes registradas</h2>
                <span class="fr-pill fr-pill-admin" id="lbl-sedes">0 registros</span>
            </div>

            <!-- Formulario: agregar sede -->
            <div class="p-4 border-bottom">
                <h5 class="mb-3">Agregar nueva sede</h5>
                <form id="form-sede" class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" id="name" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Ciudad</label>
                        <input type="text" class="form-control" id="city" required>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Región</label>
                        <input type="text" class="form-control" id="region">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" id="type">
                            <option value="Hotel">Sede Recreativa</option>
                            <option value="Apartamento">Apartamento</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Capacidad máxima</label>
                        <input type="number" class="form-control" id="maximumCapacity">
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Precio lavandería</label>
                        <input type="number" class="form-control" id="priceLaundry">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" id="description" rows="3"></textarea>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-dark" id="btn-sede">
                            Registrar sede
                        </button>
                    </div>

                </form>
            </div>

            <!-- Tabla de sedes -->
            <div class="table-responsive">
                <table class="table fr-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Ciudad</th>
                            <th>Región</th>
                            <th>Tipo</th>
                            <th>Capacidad máx.</th>
                            <th>Precio lavandería</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody id="tb-sedes">
                        <tr><td colspan="9" class="text-center text-muted py-4">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div><!-- /sec-sedes -->


    <!-- ─────────────────────────────
     SECCIÓN: ALOJAMIENTOS
───────────────────────────── -->
<div class="fr-section d-none" id="sec-accommodation">
    <div class="fr-card">

        <div class="fr-card-head">
            <h2 class="fr-card-title">Alojamientos registrados</h2>
            <span class="fr-pill fr-pill-customer" id="lbl-accommodation">0 registros</span>
        </div>

        <!-- Formulario: agregar alojamiento -->
        <div class="p-4 border-bottom">
            <h5 class="mb-3">Agregar nuevo alojamiento</h5>
            <form id="form-accommodation" class="row g-3">

                <div class="col-md-4">
                    <label class="form-label">Sede</label>
                    <!-- Poblado dinámicamente con poblarSelectSede() -->
                    <select class="form-select" id="acc-idSede" required>
                        <option value="">Selecciona una sede...</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Nombre</label>
                    <input type="text" class="form-control" id="acc-name" required>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Número</label>
                    <input type="text" class="form-control" id="acc-number" required>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Máx. personas</label>
                    <input type="number" class="form-control" id="acc-maximumPerson" required>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Estado</label>
                    <select class="form-select" id="acc-state">
                        <option value="Disponible">Disponible</option>
                        <option value="Ocupado">Ocupado</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label">Descripción</label>
                    <textarea class="form-control" id="acc-description" rows="3"></textarea>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-dark" id="btn-accommodation">
                        Registrar alojamiento
                    </button>
                </div>

            </form>
        </div>

        <div class="table-responsive">
            <table class="table fr-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>ID</th>
                        <th>Sede</th>
                        <th>Nombre</th>
                        <th>Número</th>
                        <th>Máx. personas</th>
                        <th>Estado</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="tb-accommodation">
                    <tr><td colspan="9" class="text-center text-muted py-4">Cargando...</td></tr>
                </tbody>
            </table>
        </div>

    </div>
</div><!-- /sec-accommodation -->


    <!-- ─────────────────────────────
         SECCIÓN: TEMPORADAS
    ───────────────────────────── -->
    <div class="fr-section d-none" id="sec-seasons">
        <div class="fr-card">

            <div class="fr-card-head">
                <h2 class="fr-card-title">Temporadas registradas</h2>
                <span class="fr-pill fr-pill-admin" id="lbl-seasons">0 registros</span>
            </div>

            <!-- Formulario: agregar temporada -->
            <div class="p-4 border-bottom">
                <h5 class="mb-3">Agregar temporada</h5>
                <form id="form-season" class="row g-3">

                    <div class="col-md-4">
                        <label class="form-label">Nombre</label>
