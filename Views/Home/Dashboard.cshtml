/* POST /api/sedes/create — registra una nueva sede */
document.getElementById('form-sede').addEventListener('submit', async function(e) {
    e.preventDefault();
    const body = {
        name:            document.getElementById('name').value,
        city:            document.getElementById('city').value,
        region:          document.getElementById('region').value,
        type:            document.getElementById('type').value,
        maximumCapacity: parseInt(document.getElementById('maximumCapacity').value),
        priceLaundry:    parseFloat(document.getElementById('priceLaundry').value),
        description:     document.getElementById('description').value
    };
    try {
        const res  = await fetch('/api/sedes/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
