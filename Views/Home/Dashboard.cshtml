/* ══════════════════════════════════════
   RENDER TABLAS
══════════════════════════════════════ */

/* Renderiza todas las tablas de usuarios */
function render(users) {
    const admins    = users.filter(u => u.rol === 'Admin');
    const customers = users.filter(u => u.rol === 'Customer');

    // Stat cards
    document.getElementById('s-admins').textContent   = admins.length;
    document.getElementById('s-customers').textContent = customers.length;
    document.getElementById('s-total').textContent     = users.length;

    // Badges sidebar
    document.getElementById('cnt-admins').textContent   = admins.length;
    document.getElementById('cnt-customers').textContent = customers.length;

    // Labels de cabecera
    document.getElementById('lbl-resumen').textContent   = `${users.length} usuarios`;
    document.getElementById('lbl-admins').textContent     = `${admins.length} registros`;
    document.getElementById('lbl-customers').textContent  = `${customers.length} registros`;

    // Cuerpos de tabla
    document.getElementById('tb-resumen').innerHTML =
        users.length ? users.map(filaResumen).join('') : filaVacia(8, 'No hay usuarios');

    document.getElementById('tb-admins').innerHTML =
        admins.length ? admins.map(filaAdmin).join('') : filaVacia(7, 'No hay administradores');

    document.getElementById('tb-customers').innerHTML =
        customers.length ? customers.map(filaCustomer).join('') : filaVacia(9, 'No hay clientes registrados');
}

/* Renderiza tabla de sedes */
function renderSedes(sedes) {
    document.getElementById('cnt-sedes').textContent = sedes.length;
    document.getElementById('lbl-sedes').textContent = `${sedes.length} registros`;
    document.getElementById('tb-sedes').innerHTML =
        sedes.length ? sedes.map(filaSede).join('') : filaVacia(9, 'No hay sedes registradas');
}

/* Renderiza tabla de alojamientos */
function renderAccommodation(accommodation) {
    document.getElementById('cnt-accommodation').textContent = accommodation.length;
    document.getElementById('lbl-accommodation').textContent = `${accommodation.length} registros`;
    document.getElementById('tb-accommodation').innerHTML =
        accommodation.length ? accommodation.map(filaAccommodation).join('') : filaVacia(8, 'No hay alojamientos registrados');
}

/* Renderiza tabla de temporadas */
function renderSeasons(seasons) {
    document.getElementById('cnt-seasons').textContent = seasons.length;
    document.getElementById('lbl-seasons').textContent = `${seasons.length} registros`;
    document.getElementById('tb-seasons').innerHTML =
        seasons.length ? seasons.map(filaSeason).join('') : filaVacia(5, 'No hay temporadas registradas');
}

/* Renderiza tabla de tarifas */
function renderRates(rates) {
    document.getElementById('cnt-rates').textContent = rates.length;
    document.getElementById('lbl-rates').textContent = `${rates.length} registros`;
    document.getElementById('tb-rates').innerHTML =
        rates.length ? rates.map(filaRate).join('') : filaVacia(9, 'No hay tarifas registradas');
}


/* ══════════════════════════════════════
   SELECTS DINÁMICOS (form de tarifas)
══════════════════════════════════════ */

/* Llena el select de alojamientos en el form de tarifas */
function poblarSelectAccommodation(accommodations) {
    const sel = document.getElementById('idAccommodation');
    const valorActual = sel.value;
    sel.innerHTML = '<option value="">Selecciona un alojamiento...</option>';
    accommodations.forEach(a => {
        const sede  = a.sedeName || `Sede ${a.idsede}`;  // ← idsede en minúsculas
        const city  = a.city ? ` — ${a.city}` : '';      // ← ciudad de la sede
        const name  = a.name || '';
        const num   = a.number ? ` — N° ${a.number}` : '';
        const label = `[${sede}${city}] ${name}${num}`;
        sel.innerHTML += `<option value="${a.idAccommodation}">${label}</option>`;
    });
    if (valorActual) sel.value = valorActual;
}

/* Llena el select de temporadas en el form de tarifas */
function poblarSelectSeason(seasons) {
    const sel = document.getElementById('idSeason');
    const valorActual = sel.value;
    sel.innerHTML = '<option value="">Selecciona una temporada...</option>';
    seasons.forEach(s => {
        sel.innerHTML += `<option value="${s.idSeason}">${s.name} — ${s.type}</option>`;
    });
    if (valorActual) sel.value = valorActual;
}

/* Llena el select de sedes en el form de alojamientos */
function poblarSelectSede(sedes) {
    const sel = document.getElementById('acc-idSede');
    const valorActual = sel.value;
    sel.innerHTML = '<option value="">Selecciona una sede...</option>';
    sedes.forEach(s => {
        sel.innerHTML += `<option value="${s.idSede}">${s.name}${s.city ? ' — ' + s.city : ''}</option>`;
    });
    if (valorActual) sel.value = valorActual;
}


/* ══════════════════════════════════════
   CARGA DE DATOS (GET a la API)
══════════════════════════════════════ */

/* Carga usuarios desde /api/users/all */
async function cargarUsuarios() {
    try {
        const res = await fetch('/api/users/all');
        if (!res.ok) { mostrarError(); return; }
        allUsers = await res.json();
        console.log('[FR] Usuarios:', allUsers.length);
        render(allUsers);
    } catch (err) {
        console.error('[FR] Error usuarios:', err);
        mostrarError();
    }
}

/* Carga sedes desde /api/sedes/all */
async function cargarSedes() {
    try {
        const res = await fetch('/api/sedes/all');
