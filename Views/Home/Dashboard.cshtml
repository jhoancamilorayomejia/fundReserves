        async function cargarUsuarios() {
            try {
                const res = await fetch('/api/users/all');

                if (!res.ok) {
                    console.error('Error HTTP:', res.status, res.statusText);
                    mostrarError();
                    return;
                }

                const data = await res.json();
                console.log('[FoundReserves] Usuarios recibidos:', data.length, data);
                allUsers = data;
                render(allUsers);

            } catch (err) {
                console.error('[FoundReserves] Fetch error:', err);
                mostrarError();
            }
        }

        function mostrarError() {
            document.getElementById('error-msg').classList.remove('d-none');
            ['tb-resumen','tb-admins','tb-customers'].forEach(id => {
                document.getElementById(id).innerHTML =
                    `<tr><td colspan="7" class="text-center text-danger py-4">
                        Error al cargar datos — abre F12 para ver detalles
                    </td></tr>`;
            });
        }

        /* ══════════════════════════════
           NAVEGACIÓN SIDEBAR
        ══════════════════════════════ */
        document.querySelectorAll('.fr-nav-item').forEach(item => {
            item.addEventListener('click', e => {
                e.preventDefault();
                const sec = item.dataset.section;

                // Marca activo
                document.querySelectorAll('.fr-nav-item')
                    .forEach(n => n.classList.remove('active'));
                item.classList.add('active');

                // Muestra sección
                document.querySelectorAll('.fr-section')
                    .forEach(s => s.classList.add('d-none'));
                document.getElementById('sec-' + sec).classList.remove('d-none');

                // Título header
                document.getElementById('page-title').textContent = SECTIONS[sec].title;
                document.getElementById('page-sub').textContent   = SECTIONS[sec].sub;

                // Limpia búsqueda y re-renderiza sin filtro
                document.getElementById('buscador').value = '';
                render(allUsers);
            });
        });

        /* ══════════════════════════════
           BÚSQUEDA EN TIEMPO REAL
        ══════════════════════════════ */
        document.getElementById('buscador').addEventListener('input', function () {
            const q = this.value.toLowerCase().trim();
            const filtrados = q
                ? allUsers.filter(u =>
                    (u.name     || '').toLowerCase().includes(q) ||
                    (u.lastname || '').toLowerCase().includes(q) ||
                    (u.cedula   || '').toLowerCase().includes(q) ||
                    (u.email    || '').toLowerCase().includes(q) ||
                    (u.phone    || '').includes(q))
                : allUsers;
            render(filtrados);
        });

       async function eliminarUsuario(id, nombre) {

    const confirmar = confirm(
        `¿Estás seguro de eliminar al usuario "${nombre}"?\n\n` +
        `Esta acción es permanente y no se puede deshacer.`
    );

    if (!confirmar) return;

    try {
        const res = await fetch(`/api/users/${id}`, {
            method: 'DELETE'
        });

        if (!res.ok) {
            const err = await res.json();
            alert('Error: ' + (err.message || res.statusText));
            return;
        }

        // Elimina del array local y re-renderiza
        allUsers = allUsers.filter(u => u.iduser !== id);
        render(allUsers);

        alert(`Usuario "${nombre}" eliminado correctamente`);

    } catch (err) {
        console.error('[FoundReserves] Error al eliminar:', err);
        alert('Error de conexión al intentar eliminar');
    }
}

async function eliminarTemporada(id, tipo) {

    const confirmar = confirm(
        `¿Estás seguro de eliminar la temporada "${tipo}"?\n\n` +
        `Esta acción no se puede deshacer.`
    );

    if (!confirmar) return;

    try {

        const res = await fetch(`/api/seasons/${id}`, {
            method: 'DELETE'
        });

        if (!res.ok) {

            const err = await res.json();

            alert(err.message || 'Error al eliminar temporada');

            return;
        }

        // Actualizar lista local
        allSeasons = allSeasons.filter(s => s.idSeason !== id);

        renderSeasons(allSeasons);

        alert('Temporada eliminada correctamente');

    } catch (err) {

        console.error('[FoundReserves] Error eliminar temporada:', err);

        alert('Error de conexión');
    }
}


