};


/* ══════════════════════════════════════
   HELPERS
══════════════════════════════════════ */

/* Formatea fecha ISO → "dd mmm yyyy" en español */
function fmtFecha(str) {
    if (!str) return '—';
    try {
        return new Date(str).toLocaleDateString('es-CO', {
            year: 'numeric', month: 'short', day: '2-digit'
        });
    } catch { return '—'; }
}

/* Formatea número como moneda COP */
function fmtPrecio(n) {
    if (n == null) return '—';
    return Number(n).toLocaleString('es-CO', {
        style: 'currency', currency: 'COP', maximumFractionDigits: 0
    });
}

/* Pill de rol (Admin / Customer) */
function rolPill(rol) {
    return rol === 'Admin'
        ? '<span class="fr-pill fr-pill-admin">Admin</span>'
        : '<span class="fr-pill fr-pill-customer">Cliente</span>';
}

/* Iniciales del nombre para el avatar */
function iniciales(name, last) {
    return ((name || '').charAt(0) + (last || '').charAt(0)).toUpperCase();
}

/* HTML del avatar con color según rol */
function avatarHtml(u) {
    const cls = u.rol === 'Admin' ? 'av-admin' : 'av-customer';
    return `<span class="fr-av ${cls}">${iniciales(u.name, u.lastname)}</span>`;
}

/* Fila vacía con colspan y mensaje */
function filaVacia(cols, msg) {
    return `<tr><td colspan="${cols}" class="text-center text-muted py-4">${msg}</td></tr>`;
}


/* ══════════════════════════════════════
   CONSTRUCCIÓN DE FILAS
══════════════════════════════════════ */

/* Fila para tabla RESUMEN (todos los usuarios, incluye Rol) */
function filaResumen(u, i) {
    return `<tr>
        <td class="fr-mono text-muted">${i + 1}</td>
        <td>
            <div class="d-flex align-items-center gap-2">
                ${avatarHtml(u)}
                <div>
                    <div class="fw-500">${u.name || ''} ${u.lastname || ''}</div>
                    <div class="fr-sub-email">${u.email || ''}</div>
                </div>
            </div>
        </td>
        <td class="fr-mono">${u.cedula   || '—'}</td>
        <td>${u.phone || '—'}</td>
        <td class="text-muted">${u.email || '—'}</td>
        <td>${rolPill(u.rol)}</td>
        <td class="fr-mono text-muted">${fmtFecha(u.createdAt)}</td>
        <td>
            <!-- Elimina usuario de la tabla users -->
            <button class="btn btn-sm btn-outline-danger"
                onclick="eliminarUsuario(${u.iduser}, '${u.name} ${u.lastname}')">
                Eliminar
            </button>
        </td>
    </tr>`;
}

/* Fila para tabla ADMINISTRADORES */
function filaAdmin(u, i) {
    return `<tr>
        <td class="fr-mono text-muted">${i + 1}</td>
        <td class="fr-mono text-muted">${u.iduser}</td>
        <td>
            <div class="d-flex align-items-center gap-2">
                ${avatarHtml(u)}
                <div class="fw-500">${u.name || ''} ${u.lastname || ''}</div>
            </div>
        </td>
        <td class="fr-mono">${u.cedula || '—'}</td>
        <td>${u.phone  || '—'}</td>
        <td class="text-muted">${u.email || '—'}</td>
        <td class="fr-mono text-muted">${fmtFecha(u.createdAt)}</td>
    </tr>`;
}

/* Fila para tabla CLIENTES — columnas esenciales, botón Ver abre modal */
function filaCustomer(u, i) {
    return `<tr>
        <td class="fr-mono text-muted">${i + 1}</td>
        <td class="fr-mono text-muted">${u.iduser}</td>
        <td>
            <div class="d-flex align-items-center gap-2">
                ${avatarHtml(u)}
                <div class="fw-500">${u.name || ''} ${u.lastname || ''}</div>
            </div>
        </td>
        <td class="fr-mono">${u.cedula || '—'}</td>
        <td>${u.phone  || '—'}</td>
        <td class="text-muted">${u.email || '—'}</td>
        <td>${u.municipio || '—'}</td>
        <td class="fr-mono text-muted">${fmtFecha(u.createdAt)}</td>
        <td>
            <div class="d-flex gap-2">
                <!-- Abre modal con info completa del cliente -->
                <button class="btn btn-sm fr-btn-ver"
                    onclick="verCliente(${u.iduser})">
                    Ver
                </button>
                <!-- Elimina cliente de la tabla users -->
                <button class="btn btn-sm btn-outline-danger"
                    onclick="eliminarUsuario(${u.iduser}, '${u.name} ${u.lastname}')">
                    Eliminar
                </button>
            </div>
        </td>
    </tr>`;
}

/* Abre el modal con toda la información del cliente seleccionado */
function verCliente(id) {
    const u = allUsers.find(u => u.iduser === id);
    if (!u) return;

    const si = '<span class="badge bg-success">Sí</span>';
    const no = '<span class="badge bg-secondary">No</span>';

    // Cabecera del modal
    document.getElementById('modal-avatar').textContent = iniciales(u.name, u.lastname);
    document.getElementById('modal-nombre').textContent = `${u.name || ''} ${u.lastname || ''}`;

    // Información personal
    document.getElementById('md-id').textContent          = u.iduser;
    document.getElementById('md-cedula').textContent      = u.cedula        || '—';
    document.getElementById('md-nacimiento').textContent  = fmtFecha(u.fechaNacimiento);
    document.getElementById('md-phone').textContent       = u.phone         || '—';
    document.getElementById('md-email').textContent       = u.email         || '—';

    // Ubicación
    document.getElementById('md-departamento').textContent = u.departamento || '—';
    document.getElementById('md-municipio').textContent    = u.municipio    || '—';
    document.getElementById('md-barrio').textContent       = u.barrio       || '—';
    document.getElementById('md-direccion').textContent    = u.direccion    || '—';

    // Seguridad
    document.getElementById('md-pregunta').textContent  = u.preguntaSecreta  || '—';
    document.getElementById('md-respuesta').textContent = u.respuestaSecreta || '—';

    // Autorizaciones
    document.getElementById('md-aut-correo').innerHTML  = u.autorizaCorreo  === true ? si : u.autorizaCorreo  === false ? no : '—';
    document.getElementById('md-aut-celular').innerHTML = u.autorizaCelular === true ? si : u.autorizaCelular === false ? no : '—';
    document.getElementById('md-registro').textContent  = fmtFecha(u.createdAt);

    // Botón eliminar dentro del modal
    document.getElementById('modal-btn-eliminar').onclick = () => {
        bootstrap.Modal.getInstance(document.getElementById('modal-cliente')).hide();
        eliminarUsuario(u.iduser, `${u.name} ${u.lastname}`);
    };

    new bootstrap.Modal(document.getElementById('modal-cliente')).show();
}

/* Fila para tabla SEDES */
function filaSede(s, i) {
    return `<tr>
        <td class="fr-mono text-muted">${i + 1}</td>
        <td class="fr-mono text-muted">${s.idSede}</td>
        <td><span class="fw-500">${s.name || '—'}</span></td>
        <td>${s.city   || '—'}</td>
        <td>${s.region || '—'}</td>
        <td>
            <span class="fr-pill ${s.type?.toLowerCase().includes('apart') ? 'fr-pill-customer' : 'fr-pill-admin'}">
                ${s.type || '—'}
            </span>
        </td>
        <td class="fr-mono">${s.maximumCapacity ?? '—'} <small class="text-muted">pers.</small></td>
        <td class="fr-mono">${fmtPrecio(s.priceLaundry)}</td>
        <td class="text-muted" style="max-width:260px;font-size:12.5px">${s.description || '—'}</td>
    </tr>`;
}

/* Fila para tabla ALOJAMIENTOS */
/* Fila para tabla ALOJAMIENTOS */
function filaAccommodation(a, i) {
    const estado = a.state === 'Disponible'
