document.getElementById('form-season').addEventListener('submit', async function(e) {


    e.preventDefault();

    const body = {
        dateStart: document.getElementById('dateStart').value,
        dateFinish: document.getElementById('dateFinish').value,
        type: document.getElementById('seasonType').value
    };

    try {

        const res = await fetch('/api/seasons/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(body)
        });

        const data = await res.json();

        if (!res.ok) {
            alert(data.message || 'Error al registrar temporada');
            return;
        }

        alert('Temporada registrada correctamente');

        document.getElementById('form-season').reset();

        cargarSeasons();

    } catch(err) {

        console.error(err);

        alert('Error de conexión');
    }
});


