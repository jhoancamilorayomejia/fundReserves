        <td class="fr-mono" id="maxP-${r.idPrice}">${r.maximumPerson || '—'}</td>
        <td class="fr-mono" id="pN-${r.idPrice}">${fmtPrecio(r.priceNight)}</td>
        <td class="fr-mono" id="pA-${r.idPrice}">${fmtPrecio(r.pricePersonAdditional)}</td>
        <td>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary"
