        if (!res.ok) { alert((await res.json()).message || 'Error al eliminar temporada'); return; }
        allSeasons = allSeasons.filter(s => s.idSeason !== id);
        renderSeasons(allSeasons);
        alert('Temporada eliminada correctamente');
    } catch (err) {
        console.error('[FR] Error al eliminar temporada:', err);
        alert('Error de conexión');
    }
}

