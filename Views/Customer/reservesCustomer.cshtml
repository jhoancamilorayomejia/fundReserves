/* ══════════════════════════════════════
   SUBMIT
══════════════════════════════════════ */
async function submitReserva() {
    const startDate    = document.getElementById('startDate').value;
    const endDate      = document.getElementById('endDate').value;
    const persons      = parseInt(document.getElementById('numberOfPersons').value) || 0;
    const extraPersons = parseInt(document.getElementById('extraPersons').value) || 0;
    const totalPersons = persons + extraPersons;
    const withLaundry  = document.getElementById('laundryService').checked;
    const btnSubmit    = document.getElementById('btn-submit');

    const maxInput = parseInt(document.getElementById('numberOfPersons').max) || 999;
    if (persons > maxInput) {
        showToast(`El número de personas no puede superar ${maxInput}.`, 'error');
        return;
    }

    if (selectedRooms.size === 0 || !startDate || !endDate || !persons) {
        showToast('Por favor completa todos los campos obligatorios.', 'error');
        return;
    }

    if (currentTotal <= 0) {
        showToast('El total no es válido. Verifica los datos.', 'error');
        return;
    }

    // ── Mensaje de confirmación ───────────────────────────────────────
    const habitaciones = [...selectedRooms.values()]
        .map(e => e.data.name || `N° ${e.data.number}`)
        .join(', ');

    const confirmar = confirm(
        `¿Confirmar reserva?\n\n` +
        `Habitación(es): ${habitaciones}\n` +
        `Check-in:       ${new Date(startDate + 'T00:00:00').toLocaleDateString('es-CO', { day:'2-digit', month:'long', year:'numeric' })}\n` +
        `Check-out:      ${new Date(endDate   + 'T00:00:00').toLocaleDateString('es-CO', { day:'2-digit', month:'long', year:'numeric' })}\n` +
        `Personas:       ${totalPersons}\n` +
        `Total:          ${fmtCOP(currentTotal)}\n` +
        (withLaundry ? `Lavandería:     incluida\n` : '') +
        `\nEsta acción creará la reserva en estado Pendiente.`
    );

    if (!confirmar) return;

    btnSubmit.disabled  = true;
    btnSubmit.innerHTML = 'Guardando...';

    try {
        // ── 1. Verificar disponibilidad antes de crear ────────────────
        const ids = [...selectedRooms.keys()];
        const checkUrl = `/api/reservations/available?idSede=${idSedeParam}&dateStart=${startDate}&dateFinish=${endDate}&persons=${persons}`;
        const checkRes = await fetch(checkUrl);
        if (checkRes.ok) {
            const disponibles = await checkRes.json();
            const dispIds     = disponibles.map(a => String(a.idAccommodation));
            const noDisp      = ids.filter(id => !dispIds.includes(String(id)));

            if (noDisp.length > 0) {
                const nombres = noDisp.map(id => {
                    const e = selectedRooms.get(id);
                    return e?.data?.name || `Aloj. ${id}`;
                }).join(', ');
                showToast(`No disponible en esas fechas: ${nombres}`, 'error');
                btnSubmit.disabled  = false;
                btnSubmit.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Crear reserva`;
                return;
            }
        }

        // ── 2. Crear reservas individuales ────────────────────────────
        const resultados = await Promise.allSettled(
            ids.map(idAcc =>
                fetch('/api/reservations/create', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        idUser:          parseInt(userId),
                        idAccommodation: parseInt(idAcc),
                        dateStart:       startDate,
                        dateFinish:      endDate,
                        numberPerson:    totalPersons,
                        totalCal:        currentTotal,
                        serviceLaundry:  withLaundry
                    })
                }).then(async r => {
                    const data = await r.json().catch(() => ({}));
                    if (!r.ok) throw new Error(data.message || `HTTP ${r.status}`);
                    return data;
                })
            )
        );

        const fallidos = resultados.filter(r => r.status === 'rejected');
        if (fallidos.length > 0) {
            const msgs = fallidos.map(f => f.reason?.message || 'Error').join(', ');
            showToast(`Error al crear: ${msgs}`, 'error');
            btnSubmit.disabled  = false;
            btnSubmit.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Crear reserva`;
            return;
        }

        // ── 3. Crear detalle de reserva ───────────────────────────────
        const primeraEntry = [...selectedRooms.values()][0];
        const detalleRes   = await fetch('/api/detalleReserve/create', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                idUser:       parseInt(userId),
                idSede:       parseInt(primeraEntry.data.idsede),
                dateStart:    startDate,
                dateFinish:   endDate,
                numberPerson: totalPersons,
                numberRooms:  selectedRooms.size,
                totalCal:     currentTotal
            })
        });

        if (!detalleRes.ok) {
            const err = await detalleRes.json().catch(() => ({}));
            throw new Error(err.message || `HTTP ${detalleRes.status}`);
        }

        // ── 4. Éxito ──────────────────────────────────────────────────
 // ── 4. Éxito ──────────────────────────────────────────────────
        showToast('¡Reserva creada exitosamente!', 'success');

        let segundos = 30;
        btnSubmit.disabled  = true;
        btnSubmit.innerHTML = `Si quieres hacer otra reserva podrás hacerlo en ${segundos}s`;

        const intervalo = setInterval(() => {
            segundos--;
            if (segundos <= 0) {
                clearInterval(intervalo);
                history.back();
            } else {
                btnSubmit.innerHTML = `Si quieres hacer otra reserva podrás hacerlo en ${segundos}s`;
            }
        }, 1000);

    } catch (err) {
        console.error('[FR] Error creando reserva:', err);
        showToast(`Error: ${err.message}`, 'error');
        btnSubmit.disabled  = false;
        btnSubmit.innerHTML = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Crear reserva`;
    }
}

/* ══════════════════════════════════════
   VERIFICAR DISPONIBILIDAD
══════════════════════════════════════ */
async function verificarDisponibilidad() {
    const dateStart = document.getElementById('avail-start').value; 
    const dateEnd   = document.getElementById('avail-end').value;
    const tbody     = document.getElementById('tb-avail');
    const result    = document.getElementById('avail-result');

    if (!dateStart || !dateEnd || dateEnd <= dateStart) {
        showToast('Selecciona un rango de fechas válido.', 'error');
        return;
    }

    tbody.innerHTML = `<tr><td colspan="5" class="fc-empty">Consultando...</td></tr>`;
    result.style.display = 'block';

    try {
        const url = `/api/reservations/available?idSede=${idSedeParam}&dateStart=${dateStart}&dateFinish=${dateEnd}`;
        const res  = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        if (!data.length) {
            tbody.innerHTML = `<tr><td colspan="5" class="fc-empty">No hay habitaciones disponibles en ese rango.</td></tr>`;
            return;
        }

        tbody.innerHTML = data.map(a => `
            <tr class="fc-row">
                <td style="font-weight:600;">N° ${a.number ?? '—'}</td>
                <td><span class="fc-sede-name">${a.name ?? '—'}</span></td>
                <td>${a.maximumPerson ?? '—'} pers.</td>
                <td class="fc-td-desc">${a.description ?? '—'}</td>
                <td><span class="fc-badge badge-sede">${a.state ?? 'Disponible'}</span></td>
            </tr>
        `).join('');

    } catch (err) {
        console.error('[FR] Error disponibilidad:', err);
        tbody.innerHTML = `<tr><td colspan="5" class="fc-empty fc-error">Error al consultar.</td></tr>`;
    }
}

/* ══════════════════════════════════════
   BUSCADOR DE DISPONIBILIDAD
══════════════════════════════════════ */
let availData      = [];   // resultados actuales
let calcAccId      = null; // alojamiento seleccionado en calculadora
let calcRates      = [];   // tarifas del alojamiento seleccionado

async function verificarDisponibilidad() {
    const dateStart = document.getElementById('avail-start').value;  //input mirar fechas
    const dateEnd   = document.getElementById('avail-end').value;
    const persons   = parseInt(document.getElementById('avail-persons').value) || 1;
    const cards     = document.getElementById('avail-cards');
    const result    = document.getElementById('avail-result');
    const summary   = document.getElementById('avail-summary');
    const calcPanel = document.getElementById('calc-panel');

    //verificar si el rango de fecha es permitido
    if (!dateStart || !dateEnd || dateEnd <= dateStart) {
        showToast('Selecciona un rango de fechas válido.', 'error');
        return;
    }

    cards.innerHTML          = `<p style="color:var(--text-muted,#9ca3af);font-size:13px;">Consultando...</p>`;
    result.style.display     = 'block';
    calcPanel.style.display  = 'none';

    try { //llama al backend
        const nights = diffDays(dateStart, dateEnd);
        const url    = `/api/reservations/available?idSede=${idSedeParam}&dateStart=${dateStart}&dateFinish=${dateEnd}&persons=${persons}`;
        const res    = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        availData = await res.json();

        summary.textContent = availData.length
            ? `${availData.length} habitación(es) disponible(s) · ${nights} noche(s) · ${persons} persona(s)`
            : '';

        if (!availData.length) {
            cards.innerHTML = `
                <div style="text-align:center;padding:32px;color:var(--text-muted,#9ca3af);font-size:13px;">
                    No hay habitaciones disponibles para ese rango y número de personas.
                </div>`;
            return;
        }

        cards.innerHTML = availData.map(a => {
            const tarifasBadges = a.tarifas.length
                ? a.tarifas.map(t => `
                    <span class="rv-rate-badge ${badgeClass(t.seasonType)}"
                          style="margin-right:4px;">
                        ${t.seasonName} — ${fmtCOP(t.priceNight)}/noche
                    </span>`).join('')
                : `<span style="font-size:12px;color:var(--text-muted,#9ca3af);">Sin tarifas registradas</span>`;

            return `
            <div style="background:var(--bg-card,#181818);border:1px solid var(--border);
                        border-radius:10px;padding:16px;display:flex;
                        justify-content:space-between;align-items:flex-start;gap:16px;">
                <div style="flex:1;">
                    <div style="font-weight:600;font-size:14px;margin-bottom:4px;">
                        N° ${a.number ?? '—'} — ${a.name ?? '—'}
                    </div>
                    <div style="font-size:12px;color:var(--text-muted,#9ca3af);margin-bottom:8px;">
                        Máx. ${a.maximumPerson} personas
                        ${a.description ? ' · ' + a.description : ''}
                    </div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        ${tarifasBadges}
                    </div>
                </div>
                <button type="button" onclick="abrirCalculadora(${a.idAccommodation})"
                        style="white-space:nowrap;padding:8px 16px;background:var(--accent);
                               color:#fff;border:none;border-radius:8px;font-family:inherit;
                               font-size:12px;font-weight:500;cursor:pointer;">
                    Calcular tarifa
                </button>
            </div>`;
        }).join('');

    } catch (err) {
        console.error('[FR] Error disponibilidad:', err);
        cards.innerHTML = `<p style="color:#f06080;font-size:13px;">Error al consultar disponibilidad.</p>`;
    }
}

/* ══════════════════════════════════════
   CALCULADORA DE TARIFA
══════════════════════════════════════ */
function abrirCalculadora(idAccommodation) {
    const acc       = availData.find(a => a.idAccommodation === idAccommodation);
    if (!acc) return;

    calcAccId = idAccommodation;
    calcRates = acc.tarifas || [];

    const dateStart = document.getElementById('avail-start').value;
    const dateEnd   = document.getElementById('avail-end').value;
    const persons   = document.getElementById('avail-persons').value;

    document.getElementById('calc-acc-name').value  = `N° ${acc.number} — ${acc.name ?? ''}`;
    document.getElementById('calc-persons').value   = persons;
    document.getElementById('calc-rooms').value     = 1;
    document.getElementById('calc-extra').value     = 0;

    // Mostrar tarifas disponibles
    const wrap = document.getElementById('calc-rates-wrap');
    if (calcRates.length) {
        wrap.innerHTML = `
            <p style="font-size:11px;font-weight:600;color:var(--text-muted,#9ca3af);
                      text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px;">
                Tarifas aplicables
            </p>
            <table class="rv-rates-table">
                <thead>
                    <tr>
                        <th>Temporada</th>
                        <th>Personas</th>
                        <th>Precio/noche</th>
                        <th>Pers. adicional</th>
                    </tr>
                </thead>
                <tbody>
                    ${calcRates.map(t => `
                        <tr>
                            <td><span class="rv-rate-badge ${badgeClass(t.seasonType)}">${t.seasonName}</span></td>
                            <td>${t.minimumPerson} – ${t.maximumPerson} pers.</td>
                            <td style="font-weight:600;">${fmtCOP(t.priceNight)}</td>
                            <td>${fmtCOP(t.pricePersonAdditional)}</td>
                        </tr>`).join('')}
                </tbody>
            </table>`;
    } else {
        wrap.innerHTML = `<p style="font-size:12px;color:var(--text-muted,#9ca3af);">Sin tarifas registradas.</p>`;
    }

    document.getElementById('calc-panel').style.display = 'block';
    document.getElementById('calc-panel').scrollIntoView({ behavior: 'smooth', block: 'start' });

    calcularTarifaBuscador();
}

function calcularTarifaBuscador() {
    const dateStart = document.getElementById('avail-start').value;
    const dateEnd   = document.getElementById('avail-end').value;
    const persons   = parseInt(document.getElementById('calc-persons').value)  || 1;
    const rooms     = parseInt(document.getElementById('calc-rooms').value)    || 1;
    const extra     = parseInt(document.getElementById('calc-extra').value)    || 0;
    const totalEl   = document.getElementById('calc-total');
    const breakEl   = document.getElementById('calc-breakdown');

    if (!dateStart || !dateEnd || !calcRates.length) {
        totalEl.textContent = '$ —';
        breakEl.textContent = '';
        return;
    }

    const nights   = diffDays(dateStart, dateEnd);
    const desglose = desglosarTemporadas(dateStart, dateEnd);

    let total      = 0;
    let extraTotal = 0;
    const parts    = [];

    for (const { type, nights: n } of desglose) {
        const tarifa = buscarTarifa(calcRates, type, persons);
        if (!tarifa) continue;

        const sub = tarifa.priceNight * n * rooms;
        total += sub;
        parts.push(`${type} ${n}n × ${fmtCOP(tarifa.priceNight)} × ${rooms} hab. = ${fmtCOP(sub)}`);

        if (extra > 0 && tarifa.pricePersonAdditional) {
            const subExtra = extra * tarifa.pricePersonAdditional * n;
            extraTotal += subExtra;
        }
    }

    total += extraTotal;
    if (extraTotal > 0) parts.push(`${extra} pers. adicionales = ${fmtCOP(extraTotal)}`);

    totalEl.textContent = fmtCOP(total);
    breakEl.textContent = parts.join(' · ');
}

/* ══════════════════════════════════════
   INICIO
══════════════════════════════════════ */
document.getElementById('startDate').min = today();
document.getElementById('endDate').min   = today();

cargarAlojamientos();

</script>
