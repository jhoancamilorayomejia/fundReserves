@{
    ViewData["Title"] = "Inicio";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Inicio — FoundReserves</title>
    <link rel="stylesheet" href="~/css/dashboardCustomer.css" />
</head>
<body>

<!-- ════════════════════════════════════════
     TOPBAR
════════════════════════════════════════ -->
<header class="fc-topbar">

    <div class="fc-topbar-left">
        <!-- Marca -->
        <div class="fc-brand">
            <div class="fc-brand-icon">FR</div>
            <span class="fc-brand-name">FoundReserves</span>
        </div>

        <!-- Navegación principal -->
        <nav class="fc-top-nav">
            <button class="fc-top-link active" data-tab="sedes">Sedes</button>
            <button class="fc-top-link"        data-tab="apartamentos">Apartamentos</button>
            <button class="fc-top-link"        data-tab="misreservas">Mis reservas</button>
        </nav>
    </div>

    <div class="fc-topbar-right">
        <!-- Chip de usuario -->
        <div class="fc-user-chip">
    <div class="fc-user-avatar">
        @(ViewBag.Name     != null ? ((string)ViewBag.Name).Substring(0,1).ToUpper()     : "C")@(ViewBag.Lastname != null ? ((string)ViewBag.Lastname).Substring(0,1).ToUpper() : "")
    </div>
    <div style="display:flex; flex-direction:column; line-height:1.3;">
        <span class="fc-user-label" style="color:var(--text); font-weight:500;">
            @ViewBag.Name @ViewBag.Lastname
        </span>
        <span class="fc-user-label" style="font-size:11px;">
            ID: @ViewBag.IdUser &nbsp;·&nbsp; @ViewBag.Email
        </span>
        <span class="fc-user-label" style="font-size:11px;">
            @ViewBag.Cedula &nbsp;·&nbsp; @ViewBag.Phone
        </span>
    </div>
</div>

        <!-- Cerrar sesión -->
        <form method="post" asp-controller="Home" asp-action="Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="fc-btn-logout">Cerrar sesión</button>
        </form>
    </div>

</header>


<!-- ════════════════════════════════════════
     CONTENIDO PRINCIPAL
════════════════════════════════════════ -->
<main class="fc-main">

    <!-- Cabecera de página -->
    <div class="fc-page-header">
        <h1 class="fc-page-title" id="page-title">Sedes disponibles</h1>
        <p  class="fc-page-sub"   id="page-sub">Explora nuestras sedes recreativas</p>
    </div>

    <!-- Sub-tabs (Sede / Apartamento) -->
    <div class="fc-subtabs">
        <button class="fc-subtab active" data-tab="sedes">
            Sede Recreativa
        </button>
        <button class="fc-subtab" data-tab="apartamentos">
            Apartamento
        </button>
    </div>

    <!-- Buscador -->
    <div class="fc-search-bar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
        <input type="text" id="buscador" placeholder="Buscar por nombre, ciudad o región..." />
    </div>

    <!-- Error banner -->
    <div id="error-msg" class="fc-empty fc-error" style="display:none">
        No se pudieron cargar las sedes. Revisa la consola (F12) para más detalles.
    </div>

    <!-- Tabla -->
    <div class="fc-table-wrap" id="wrap-sedes">
        <table class="fc-table">
            <thead>
                <tr>
                    <th class="col-img">Imagen</th>
                    <th>Nombre</th>
                    <th>Ciudad</th>
                    <th>Región</th>
                    <th>Tipo</th>
                    <th>Capacidad máx.</th>
                    <th>Precio lavandería</th>
                    <th>Descripción</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="tb-sedes">
                <tr>
                    <td colspan="9" class="fc-empty">Cargando...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- ════════ PANEL: MIS RESERVAS ════════ -->
<div id="panel-misreservas" style="display:none">

    <!-- Tarjetas de estadísticas -->
    <div class="fc-stats-grid">
        <div class="fc-stat-card">
            <span class="fc-stat-label">Total</span>
            <span class="fc-stat-val" id="stat-total">—</span>
        </div>
        <div class="fc-stat-card">
            <span class="fc-stat-label">Pendientes</span>
            <span class="fc-stat-val fc-stat-warn" id="stat-pend">—</span>
        </div>
        <div class="fc-stat-card">
            <span class="fc-stat-label">Confirmadas</span>
            <span class="fc-stat-val fc-stat-ok" id="stat-conf">—</span>
        </div>
        <div class="fc-stat-card">
            <span class="fc-stat-label">Completadas</span>
            <span class="fc-stat-val fc-stat-info" id="stat-comp">—</span>
        </div>
    </div>

    <!-- Tabla de reservas -->
    <div class="fc-table-wrap">
        <table class="fc-table">
            <thead>
    <tr>
        <th>#</th>
        <th>Sede</th>
        <th>Personas</th>
        <th>Check-in</th>
        <th>Check-out</th>
        <th>Total</th>
        <th>Habitaciones</th>
        <th>Fecha y hora de creacion</th>
        <th>Comprobante</th>
        <th>Acciones</th>
    </tr>
</thead>
            <tbody id="tb-misreservas">
                <tr><td colspan="9" class="fc-empty">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

</main>


<!-- ════════════════════════════════════════
     MODAL: DETALLE DE SEDE
════════════════════════════════════════ -->
<div class="fc-modal-overlay d-none" id="modal-overlay">
    <div class="fc-modal" id="modal-sede" role="dialog" aria-modal="true">

        <button class="fc-modal-close" id="modal-close" aria-label="Cerrar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>

        <!-- Imagen de cabecera -->
        <div id="modal-img-wrap" class="fc-modal-img-wrap">
            <!-- Se inyecta con JS: <img> o placeholder SVG -->
        </div>

        <div class="fc-modal-body">

            <h3 class="fc-modal-title" id="modal-nombre">—</h3>

            <div class="fc-modal-meta">
                <span class="fc-badge" id="modal-tipo-badge">—</span>
                <span class="fc-modal-city" id="modal-ciudad">—</span>
            </div>

            <p class="fc-modal-desc" id="modal-desc">—</p>

            <div class="fc-modal-info-grid">
                <div class="fc-info-item">
                    <span class="fc-info-label">Región</span>
                    <span class="fc-info-val" id="modal-region">—</span>
                </div>
                <div class="fc-info-item">
                    <span class="fc-info-label">Tipo</span>
                    <span class="fc-info-val" id="modal-tipo">—</span>
                </div>
                <div class="fc-info-item">
                    <span class="fc-info-label">Capacidad máxima</span>
                    <span class="fc-info-val" id="modal-capacidad">—</span>
                </div>
                <div class="fc-info-item">
                    <span class="fc-info-label">Precio lavandería</span>
                    <span class="fc-info-val mono" id="modal-lavanderia">—</span>
                </div>
            </div>

        </div>

        <div class="fc-modal-footer">
            <button class="fc-btn-secondary" id="modal-btn-cerrar">Cerrar</button>
            <button class="fc-btn-primary" id="modal-btn-reservar"onclick="irAReserva()">
                Reservar ahora
            </button>
        </div>

    </div>

</div>

 <!-- MODAL: INFO RESERVAS -->
<div class="fc-modal-overlay d-none" id="modal-reservas-overlay">
    <div class="fc-modal" style="max-width:720px" role="dialog" aria-modal="true">

        <button class="fc-modal-close" onclick="cerrarModalReservas()" aria-label="Cerrar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>

        <div class="fc-modal-body">
            <h3 class="fc-modal-title">Detalle de habitaciones reservadas</h3>
            <p style="font-size:12px;color:var(--text-muted,#9ca3af);margin-bottom:12px">
                Habitaciones individuales asociadas a esta reserva
            </p>
            <div class="fc-table-wrap">
                <table class="fc-table">
                    <thead>
    <tr>
        <th>Habitación</th>
        <th>Descripción</th>
        <th>Estado</th>
    </tr>
</thead>
                    <tbody id="tb-modal-reservas">
                        <tr><td colspan="6" class="fc-empty">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="fc-modal-footer">
            <button class="fc-btn-secondary" onclick="cerrarModalReservas()">Cerrar</button>
        </div>

    </div>
</div>


<!-- ════════════════════════════════════════
     SCRIPTS
════════════════════════════════════════ -->
<script>

/* ══════════════════════════════════════
   MAPA: nombre de ciudad → archivo de imagen
══════════════════════════════════════ */
const IMG_MAP = {
    'sede recreativa villeta': 'villeta.jpg',
    'sede tablones': 'palmira.jpeg',
    'sede recreativa el placer': 'fusagasuga.jpeg',
    'sede manguruma': 'SantaFeAntioquia.jpeg',
    'sede gonzalo morante': 'Chinchina.jpeg',
    'edificio reina 1': 'SantaMarta.jpg',
    'edificio suramericana': 'Medellin.jpg',
    'sede federman': 'Bogota.jpg'
};

function resolverImagen(sede) {
    const nombre = (sede.name || '').toLowerCase().trim();
    if (IMG_MAP[nombre]) return `/images/${IMG_MAP[nombre]}`;
    return null;
}

/* ══════════════════════════════════════
   ESTADO GLOBAL
══════════════════════════════════════ */
let allSedes   = [];
let filtroTipo = 'sedes';

/* ══════════════════════════════════════
   HELPERS
══════════════════════════════════════ */
function fmtPrecio(n) {
    if (n == null) return '—';
    return Number(n).toLocaleString('es-CO', {
        style: 'currency', currency: 'COP', maximumFractionDigits: 0
    });
}

function fmtFecha(val) {
    if (!val) return '—';
    const d = new Date(val);
    return isNaN(d) ? val : d.toLocaleDateString('es-CO', {
        day: '2-digit', month: 'short', year: 'numeric'
    });
}

function fmtFechaHora(val) {
    if (!val) return '—';
    const d = new Date(val);
    if (isNaN(d)) return val;
    const fecha = d.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' });
    const hora  = d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit', hour12: false });
    return `${fecha}, ${hora}`;
}

function esSede(s)        { return (s.type || '').toLowerCase().includes('hotel') || (s.type || '').toLowerCase().includes('recreativ'); }
function esApartamento(s) { return (s.type || '').toLowerCase().includes('apart'); }

function tipoPill(tipo) {
    if (!tipo) return '<span class="fc-badge badge-sede">—</span>';
    const lower = tipo.toLowerCase();
    if (lower.includes('apart'))
        return `<span class="fc-badge badge-apart">${tipo}</span>`;
    return `<span class="fc-badge badge-sede">${tipo}</span>`;
}

/* ══════════════════════════════════════
   MIS RESERVAS
══════════════════════════════════════ */
function renderMisReservas(reservas) {
    const tbody = document.getElementById('tb-misreservas');

    document.getElementById('stat-total').textContent = reservas.length;
    document.getElementById('stat-pend').textContent  = 0;
    document.getElementById('stat-conf').textContent  = 0;
    document.getElementById('stat-comp').textContent  = 0;

    if (!reservas.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="fc-empty">No tienes reservas aún</td></tr>`;
        return;
    }

    tbody.innerHTML = reservas.map((r, i) => {

        const sedeObj    = allSedes.find(s => s.idSede === r.idSede);
        const sedeNombre = sedeObj ? sedeObj.name : `Sede #${r.idSede ?? '—'}`;

        const comprobanteCell = r.paymentProof
            ? `<a href="${r.paymentProof}" target="_blank" class="fc-btn-select">Ver PDF</a>`
            : `<label class="fc-btn-select" style="cursor:pointer;">
                   Subir PDF
                   <input type="file" accept="application/pdf" style="display:none"
                          onchange="subirPDF(${r.idDetalleReserve}, this)" />
               </label>`;

        return `
        <tr class="fc-row">
            <td style="font-weight:600;color:var(--text-muted,#9ca3af)">${i + 1}</td>
            <td><span class="fc-sede-name">${sedeNombre}</span></td>
            <td style="font-size:12px;color:#888">${r.numberPerson ?? '—'} pers.</td>
            <td>${fmtFecha(r.dateStart)}</td>
            <td>${fmtFecha(r.dateFinish)}</td>
            <td class="fc-td-price">${fmtPrecio(r.totalCal)}</td>
            <td style="text-align:center">${r.numberRooms ?? '—'}</td>
            <td style="font-size:12px;color:var(--text-muted,#9ca3af)">${fmtFechaHora(r.createdAt)}</td>
            <td>${comprobanteCell}</td>
            <td>
    <button class="fc-btn-select"
        onclick="verInfoReserva(${r.idUser}, '${r.dateStart}', '${r.dateFinish}', '${r.createdAt}')"
        ${!r.createdAt ? 'disabled title="Sin fecha de creación"' : ''}>
    Ver info
</button>
    <button class="fc-btn-select" style="background:#e53e3e;margin-top:4px"
            onclick="eliminarReserva(${r.idDetalleReserve})">
        Eliminar
    </button>
</td>
        </tr>`;
    }).join('');
}

async function cargarMisReservas() {
    const idUser = @ViewBag.IdUser;
    try {
        const res = await fetch(`/api/detalleReserve/byUser/${idUser}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        renderMisReservas(data);
    } catch (err) {
        console.error('[FR] Error detalleReserve:', err);
        document.getElementById('tb-misreservas').innerHTML =
            `<tr><td colspan="9" class="fc-empty fc-error">Error al cargar reservas</td></tr>`;
    }
}

/* ══════════════════════════════════════
   RENDER TABLA SEDES
══════════════════════════════════════ */
function renderSedes(sedes) {
    const tbody = document.getElementById('tb-sedes');

    if (!sedes.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="fc-empty">No hay registros para este tipo</td></tr>`;
        return;
    }

    tbody.innerHTML = sedes.map((s, i) => {
        const imgSrc = resolverImagen(s);
        const imgCell = imgSrc
            ? `<img class="fc-sede-img" src="${imgSrc}" alt="${s.name || ''}"
                    onerror="this.outerHTML='<div class=\\'fc-img-placeholder\\'><svg width=\\'22\\'height=\\'22\\'viewBox=\\'0 0 24 24\\'fill=\\'none\\'stroke=\\'currentColor\\'stroke-width=\\'1.5\\'><rect x=\\'3\\'y=\\'3\\'width=\\'18\\'height=\\'18\\'rx=\\'2\\'/><circle cx=\\'8.5\\'cy=\\'8.5\\'r=\\'1.5\\'/><polyline points=\\'21 15 16 10 5 21\\'/></svg></div>'">`
            : `<div class="fc-img-placeholder">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect x="3" y="3" width="18" height="18" rx="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                    </svg>
               </div>`;

        return `<tr class="fc-row">
            <td>${imgCell}</td>
            <td><span class="fc-sede-name">${s.name || '—'}</span></td>
            <td class="fc-td-city">${s.city   || '—'}</td>
            <td class="fc-td-city">${s.region || '—'}</td>
            <td>${tipoPill(s.type)}</td>
            <td><span class="fc-cap">${s.maximumCapacity ?? '—'} <small>pers.</small></span></td>
            <td class="fc-td-price">${fmtPrecio(s.priceLaundry)}</td>
            <td class="fc-td-desc">${s.description || '—'}</td>
            <td>
                <button class="fc-btn-select" onclick="abrirModal(${s.idSede})">
                    Ver detalle
                </button>
            </td>
        </tr>`;
    }).join('');
}

/* ══════════════════════════════════════
   FILTRAR Y BUSCAR
══════════════════════════════════════ */
function filtrarYRender() {
    const q = (document.getElementById('buscador').value || '').toLowerCase().trim();

    let lista = filtroTipo === 'sedes'
        ? allSedes.filter(s => !esApartamento(s))
        : allSedes.filter(s =>  esApartamento(s));

    if (q) {
        lista = lista.filter(s =>
            (s.name   || '').toLowerCase().includes(q) ||
            (s.city   || '').toLowerCase().includes(q) ||
            (s.region || '').toLowerCase().includes(q)
        );
    }

    renderSedes(lista);
}

/* ══════════════════════════════════════
   MODAL
══════════════════════════════════════ */
function abrirModal(idSede) {
    const s = allSedes.find(x => x.idSede === idSede);
    if (!s) return;

    const wrap   = document.getElementById('modal-img-wrap');
    const imgSrc = resolverImagen(s);
    if (imgSrc) {
        wrap.innerHTML = `<img src="${imgSrc}" alt="${s.name || ''}"
            onerror="this.parentElement.innerHTML='<div class=\\'fc-modal-img-placeholder\\'><svg width=\\'36\\'height=\\'36\\'viewBox=\\'0 0 24 24\\'fill=\\'none\\'stroke=\\'currentColor\\'stroke-width=\\'1.2\\'><rect x=\\'3\\'y=\\'3\\'width=\\'18\\'height=\\'18\\'rx=\\'2\\'/><circle cx=\\'8.5\\'cy=\\'8.5\\'r=\\'1.5\\'/><polyline points=\\'21 15 16 10 5 21\\'/></svg></div>'">`;
    } else {
        wrap.innerHTML = `<div class="fc-modal-img-placeholder">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
            </svg>
        </div>`;
    }

    const lower    = (s.type || '').toLowerCase();
    const badgeCls = lower.includes('apart') ? 'badge-apart' : 'badge-sede';
    document.getElementById('modal-tipo-badge').className   = `fc-badge ${badgeCls}`;
    document.getElementById('modal-tipo-badge').textContent = s.type || '—';
    document.getElementById('modal-btn-reservar').dataset.idSede = s.idSede;
    document.getElementById('modal-nombre').textContent     = s.name            || '—';
    document.getElementById('modal-ciudad').textContent     = s.city            || '—';
    document.getElementById('modal-desc').textContent       = s.description     || '—';
    document.getElementById('modal-region').textContent     = s.region          || '—';
    document.getElementById('modal-tipo').textContent       = s.type            || '—';
    document.getElementById('modal-capacidad').textContent  = s.maximumCapacity != null ? `${s.maximumCapacity} personas` : '—';
    document.getElementById('modal-lavanderia').textContent = fmtPrecio(s.priceLaundry);

    document.getElementById('modal-overlay').classList.remove('d-none');
    document.body.style.overflow = 'hidden';
}

function cerrarModal() {
    document.getElementById('modal-overlay').classList.add('d-none');
    document.body.style.overflow = '';
}

document.getElementById('modal-close').addEventListener('click', cerrarModal);
document.getElementById('modal-btn-cerrar').addEventListener('click', cerrarModal);
document.getElementById('modal-overlay').addEventListener('click', function(e) {
    if (e.target === this) cerrarModal();
});

/* ══════════════════════════════════════
   TABS
══════════════════════════════════════ */
const TABS_META = {
    sedes:        { title: 'Sedes disponibles',        sub: 'Explora nuestras sedes recreativas' },
    apartamentos: { title: 'Apartamentos disponibles', sub: 'Explora nuestros apartamentos'      },
    misreservas:  { title: 'Mis reservas',             sub: 'Historial y estado de tus reservas' }
};

function activarTab(tab) {
    filtroTipo = tab;

    document.querySelectorAll('.fc-top-link, .fc-subtab').forEach(l =>
        l.classList.toggle('active', l.dataset.tab === tab));

    document.getElementById('page-title').textContent = TABS_META[tab]?.title ?? '';
    document.getElementById('page-sub').textContent   = TABS_META[tab]?.sub   ?? '';
    document.getElementById('buscador').value = '';

    const esMisReservas = tab === 'misreservas';
    document.querySelector('.fc-subtabs').style.display    = esMisReservas ? 'none' : '';
    document.querySelector('.fc-search-bar').style.display = esMisReservas ? 'none' : '';
    document.getElementById('wrap-sedes').style.display    = esMisReservas ? 'none' : '';
    document.getElementById('panel-misreservas').style.display = esMisReservas ? '' : 'none';

    if (esMisReservas) {
        cargarMisReservas();
    } else {
        filtrarYRender();
    }
}

document.querySelectorAll('[data-tab]').forEach(el => {
    el.addEventListener('click', () => activarTab(el.dataset.tab));
});

function irAReserva() {
    const btn    = document.getElementById('modal-btn-reservar');
    const idSede = btn.dataset.idSede || '';
    window.location.href = `/Home/ReservesCustomer?idSede=${idSede}`;
}

/* ══════════════════════════════════════
   BUSCADOR
══════════════════════════════════════ */
document.getElementById('buscador').addEventListener('input', filtrarYRender);

/* ══════════════════════════════════════
   CARGA DE DATOS
══════════════════════════════════════ */
async function cargarSedes() {
    try {
        const res = await fetch('/api/sedes/all');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        allSedes = await res.json();
        filtrarYRender();
    } catch (err) {
        console.error('[FR] Error sedes:', err);
        document.getElementById('error-msg').style.display = 'block';
        document.getElementById('tb-sedes').innerHTML =
            `<tr><td colspan="9" class="fc-empty fc-error">Error al cargar datos</td></tr>`;
    }
}

async function subirPDF(idDetalleReserve, input) {
    const file = input.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);

    try {
        const res  = await fetch(`/api/detalleReserve/uploadProof/${idDetalleReserve}`, {
            method: 'POST',
            body:   formData
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || 'Error');
        alert('PDF subido correctamente');
        cargarMisReservas();
    } catch (err) {
        console.error(err);
        alert('Error al subir PDF');
    }
}

/* ══════════════════════════════════════
   MODAL: INFO RESERVAS
══════════════════════════════════════ */
function truncarSegundo(val) {
    const d = new Date(val);
    d.setMilliseconds(0);
    return d.getTime();
}

async function verInfoReserva(idUser, dateStart, dateFinish, createdAt) {
    try {
        const url = `/api/reservations/byUserAndDate?idUser=${idUser}&dateStart=${encodeURIComponent(dateStart)}&dateFinish=${encodeURIComponent(dateFinish)}`;
        const res  = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();

        // Filtra el frontend comparando al segundo
        const createdAtTrunc = truncarSegundo(createdAt);
        const filtradas = data.filter(r =>
            truncarSegundo(r.dateCreation) === createdAtTrunc
        );

        renderModalReservas(filtradas);
        document.getElementById('modal-reservas-overlay').classList.remove('d-none');
        document.body.style.overflow = 'hidden';
    } catch (err) {
        console.error('[FR] Error reservas:', err);
        alert('Error al cargar información de reservas');
    }
}

function renderModalReservas(reservas) {
    const tbody = document.getElementById('tb-modal-reservas');
    if (!reservas.length) {
        tbody.innerHTML = `<tr><td colspan="3" class="fc-empty">Sin reservas asociadas</td></tr>`;
        return;
    }
    tbody.innerHTML = reservas.map(r => `
        <tr class="fc-row">
            <td><span class="fc-sede-name">${r.accommodationName ?? '—'}</span></td>
            <td class="fc-td-desc">${r.accommodationDescription ?? '—'}</td>
            <td><span class="fc-badge">${r.state ?? '—'}</span></td>
        </tr>
    `).join('');
}

function cerrarModalReservas() {
    document.getElementById('modal-reservas-overlay').classList.add('d-none');
    document.body.style.overflow = '';
}

async function eliminarReserva(idDetalleReserve) {
    if (!confirm('¿Seguro que deseas eliminar esta reserva?')) return;
    try {
        const res = await fetch(`/api/detalleReserve/${idDetalleReserve}`, { method: 'DELETE' });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        alert('Reserva eliminada');
        cargarMisReservas();
    } catch (err) {
        console.error(err);
        alert('Error al eliminar');
    }
}

/* ══════════════════════════════════════
   INICIO
══════════════════════════════════════ */
cargarSedes();

